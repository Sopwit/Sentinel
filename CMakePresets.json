{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 27,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_DISABLE_FIND_PACKAGE_WrapVulkanHeaders": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_DISABLE_FIND_PACKAGE_WrapVulkanHeaders": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "relwithdebinfo",
      "displayName": "Release with debug info",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/relwithdebinfo",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_DISABLE_FIND_PACKAGE_WrapVulkanHeaders": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "package-ready",
      "displayName": "Package-ready release",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/package-ready",
      "cacheVariables": {
        "SENTINEL_BUILD_NUMBER": "0"
      }
    },
    {
      "name": "tests",
      "displayName": "Tests",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/tests"
    },
    {
      "name": "no-ccache",
      "displayName": "Debug without ccache wrapper",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/no-ccache"
    },
    {
      "name": "asan",
      "displayName": "Debug with AddressSanitizer",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS_DEBUG": "-g -O1 -fsanitize=address -fno-omit-frame-pointer"
      }
    },
    {
      "name": "coverage",
      "displayName": "Debug with Code Coverage",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/coverage",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS_DEBUG": "-g -O0 --coverage"
      }
    },
    {
      "name": "windows-arm64",
      "displayName": "Windows ARM64 Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/arm64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_SYSTEM_PROCESSOR": "ARM64",
        "CMAKE_DISABLE_FIND_PACKAGE_WrapVulkanHeaders": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "relwithdebinfo",
      "configurePreset": "relwithdebinfo"
    },
    {
      "name": "package-ready",
      "configurePreset": "package-ready",
      "targets": [
        "sentinel-desktop"
      ]
    },
    {
      "name": "tests",
      "configurePreset": "tests"
    },
    {
      "name": "no-ccache",
      "configurePreset": "no-ccache"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "windows-arm64",
      "configurePreset": "windows-arm64",
      "targets": [
        "sentinel-desktop"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "tests",
      "configurePreset": "tests",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "no-ccache",
      "configurePreset": "no-ccache",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "packagePresets": [
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "package-ready",
      "configurePreset": "package-ready"
    }
  ],
  "workflowPresets": [
    {
      "name": "ci-test",
      "displayName": "CI Test Workflow",
      "steps": [
        {
          "type": "configure",
          "name": "tests"
        },
        {
          "type": "build",
          "name": "tests"
        },
        {
          "type": "test",
          "name": "tests"
        }
      ]
    },
    {
      "name": "ci-package",
      "displayName": "CI Package Workflow",
      "steps": [
        {
          "type": "configure",
          "name": "package-ready"
        },
        {
          "type": "build",
          "name": "package-ready"
        },
        {
          "type": "package",
          "name": "package-ready"
        }
      ]
    }
  ]
}
