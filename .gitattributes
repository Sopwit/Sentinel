# Auto-detect text files and normalize line endings
* text=auto

# Source code files - LF line endings (consistent across platforms)
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.qml text eol=lf
*.cmake text eol=lf
*.cmake.in text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.ts text eol=lf
*.svg text eol=lf

# Windows-specific files - CRLF line endings
*.ps1 text eol=crlf
*.bat text eol=crlf
*.rc text eol=crlf
*.rc.in text eol=crlf
*.ico binary
*.icns binary
*.png binary
*.bmp binary
*.wav binary
*.ttf binary
*.dmg binary
*.msi binary
*.AppImage binary

# Rust and repository tooling
*.rs text eol=lf
*.toml text eol=lf
Cargo.lock text eol=lf
*.py text eol=lf
*.mjs text eol=lf

# Canonical art/source models and media must never receive text conversion
*.blend binary
*.blend1 binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
