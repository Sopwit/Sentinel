[Desktop Entry]
Type=Application
Version=1.1
Name=Sentinel Desktop
GenericName=Local AI Assistant
GenericName[tr]=Yerel Yapay Zeka Asistanı
Comment=Local-first AI desktop assistant optimized for Fedora KDE Plasma
Comment[tr]=Fedora KDE Plasma için optimize edilmiş yerel öncelikli yapay zeka masaüstü asistanı
Exec=sentinel-desktop %U
Icon=dev.sentinel.Sentinel
Terminal=false
Categories=Utility;
Keywords=AI;Assistant;Local;Privacy;LLM;Qt;KDE;Sentinel;Ollama;
StartupWMClass=dev.sentinel.Sentinel
DBusActivatable=true
X-SingleMainWindow=true
MimeType=x-scheme-handler/sentinel;

