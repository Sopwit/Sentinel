<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<dictionary title="Sentinel Scripting Dictionary">
    <suite name="Sentinel Suite" code="Stnl" description="Scripting and Shortcuts commands for Sentinel Desktop">
        <command name="ask sentinel" code="StnlAskS" description="Send a prompt query to Sentinel local assistant">
            <direct-parameter type="text" description="The text prompt or question to send to Sentinel"/>
            <result type="text" description="The response text generated by Sentinel"/>
        </command>

        <command name="clear chat" code="StnlClrC" description="Clear current conversation state">
            <result type="boolean" description="True if chat state was reset successfully"/>
        </command>

        <class name="application" code="capp" description="Sentinel Application">
            <cocoa class="NSApplication"/>
            <property name="active mode" code="pMod" type="text" access="r" description="The currently selected assistant operating mode"/>
            <property name="version" code="vers" type="text" access="r" description="The application version string"/>
        </class>
    </suite>
</dictionary>
